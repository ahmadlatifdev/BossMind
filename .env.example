# BossMind does not read these itself. The agents do, once installed.
# Leave them unset until you choose a provider. Local models (Ollama) avoid hosted keys.

# Aider, Codex CLI, and many LiteLLM-based agents
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini CLI
GEMINI_API_KEY=

# Goose
GOOSE_PROVIDER=
GOOSE_MODEL=

# mini-swe-agent reads the model from --model or its own config.
