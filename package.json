{
  "name": "bossmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Install and integrate free open-source coding agents behind one BossMind command.",
  "bin": {
    "bossmind": "./bin/bossmind.mjs"
  },
  "scripts": {
    "test": "node --test",
    "start": "node bin/bossmind.mjs serve",
    "agents:install": "node bin/bossmind.mjs install --all",
    "agents:status": "node bin/bossmind.mjs status"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
